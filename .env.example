# TANISH'S SETUP TOOLKIT · tanisheesh.in
# Copy to .env (gitignored) and fill in. The scripts read these as env vars.

# GitHub: github.com/settings/tokens → classic, `repo` scope
GITHUB_TOKEN=

# Vercel: vercel.com/account/tokens (or use local `vercel login` CLI auth)
VERCEL_TOKEN=
# Optional Vercel Team ID if project belongs to a team
VERCEL_TEAM_ID=

# Render: dashboard.render.com → Account → API Keys
RENDER_API_KEY=

# GoDaddy: developer.godaddy.com/keys → format KEY:SECRET (or use local gddy CLI)
GODADDY_KEY=

# Weekly maintenance report email (set as repo secrets by setup-github-repo.ps1)
# Gmail address that sends the report
MAIL_USERNAME=
# Gmail App Password: myaccount.google.com/apppasswords
MAIL_PASSWORD=
# Optional: override recipient email (repo variable REPORT_EMAIL)
REPORT_EMAIL=
# Optional: fine-grained PAT with read access to Dependabot, Code scanning, Secret scanning alerts
ALERTS_TOKEN=

# Optional: BYOK AI PR review secrets (only needed if enabling ai-review.yml on private repos)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tanish Poddar · tanisheesh.in · github.com/tanisheesh · hi@tanisheesh.in
