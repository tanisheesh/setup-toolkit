# TANISH'S SETUP TOOLKIT · tanisheesh.in
# Copy to .env (gitignored) and fill in. The scripts read these as env vars.

# GitHub: github.com/settings/tokens → classic, `repo` scope
GITHUB_TOKEN=

# Vercel: vercel.com/account/tokens
VERCEL_TOKEN=

# Render: dashboard.render.com → Account → API Keys
RENDER_API_KEY=

# GoDaddy: developer.godaddy.com/keys → format KEY:SECRET
GODADDY_KEY=

# Weekly maintenance report email (set as repo secrets by setup-github-repo.ps1)
# Gmail address that sends the report
MAIL_USERNAME=
# Gmail App Password: myaccount.google.com/apppasswords
MAIL_PASSWORD=
# optional: fine-grained PAT, "Dependabot alerts: read"
ALERTS_TOKEN=

# Tanish Poddar · tanisheesh.in · github.com/tanisheesh · hey@tanisheesh.in
